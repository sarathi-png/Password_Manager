# Vault backend configuration
# Copy to backend/.env and fill in real values.

# SQLite (default, dev):  sqlite:///./data/vault.db
# PostgreSQL (prod):      postgresql+psycopg://user:pass@host:5432/vault
DATABASE_URL=sqlite:///./data/vault.db

# JWT signing secret — use a long random string (min 32 chars)
JWT_SECRET=generate-a-long-random-string-here

# Vault master key — base64 of exactly 32 bytes.
# Generate with:  python -c "from app.crypto import generate_master_key_b64; print(generate_master_key_b64())"
# If empty, a key file is auto-created at data/master.key (dev only).
VAULT_MASTER_KEY=

# Initial admin account (created on first startup)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me-now

# CORS: comma-separated origins or *
CORS_ORIGINS=*

# Rate limits (requests per minute)
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=300